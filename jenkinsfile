pipeline {
    agent {
        label 'worker'
    }

    environment {
        my_aws_access = credentials('aws-access')
    }

    tools {
        maven 'maven'
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/dnyaneshwar-dhas/studentapp-ui.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to s3') {
            steps {
                sh '''
                    aws s3 cp target/*.war s3://omkar.space/Artifacts/student.war
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 4, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t studentapp:latest .
                    docker images
                '''
            }
        }

        stage('push image to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 872582135546.dkr.ecr.us-east-2.amazonaws.com
                    docker tag studentapp:latest 872582135546.dkr.ecr.us-east-2.amazonaws.com/studentapp:latest
                    docker push 872582135546.dkr.ecr.us-east-2.amazonaws.com/studentapp:latest
                '''
            }
        }
    }
}
