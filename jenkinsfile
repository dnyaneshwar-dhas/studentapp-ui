pipeline {
    agent {
        label 'worker'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    tools {
        maven 'maven'
    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/mayurpandit25/studentapp-ui.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war', fingerprint: true
                }
            }
        }

        stage('Artifacts to S3') {
            steps {
                sh '''
                aws s3 cp target/*.war s3://mayurcbz.space/Artifacts/student.war
                '''
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                docker build -t studentapp:latest .
                docker images
                '''
            }
        }

        stage('push image to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 942049393829.dkr.ecr.us-east-2.amazonaws.com
                docker tag studentapp:latest 942049393829.dkr.ecr.us-east-2.amazonaws.com/studentapp:latest
                docker push 942049393829.dkr.ecr.us-east-2.amazonaws.com/studentapp:latest
                '''
            }
        }
    }
}