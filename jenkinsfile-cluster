pipeline {
    agent {
        label 'worker'
    }



    tools {
        terraform 'tf'
    }


    environment {
        my_aws_cred = credentials('aws-access')
    }


    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/dnyaneshwar-dhas/studentapp-ui.git'
            }
        }


        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }



        stage('Terraform Plan') {
            steps {
                sh 'terraform plan'
            }
        }



        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve'
            }

        }
    }
}